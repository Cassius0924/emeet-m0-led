#!/usr/bin/env python3
"""
emeet-led — control the eMeet M0 USB speakerphone LEDs (Linux).

The eMeet M0 exposes a HID interface (VID:PID 0483:5730, "eMeet Tech eMeet M0")
whose output reports drive the ring light and the call-button LED:

  report 3 = ring: flash GREEN,   btn: solid GREEN   (shared report)
  report 4 = ring: solid RED
  report 5 = btn:  solid RED
  report 6 = ring: solid BLUE

Hardware limitation (verified on device):
  Report 3 is DOMINANT over the ring. When report 3 is active the ring shows
  flashing green no matter what reports 4/6 say. So these combos are IMPOSSIBLE:
    - green button with red/blue ring  (ring will flash green)
    - flashing green ring with red button
  All other states combine cleanly.

Usage:
  emeet-led <preset>            red blue green btn-red all-red blue-red off demo
  emeet-led <ring> <btn>        ring: red|blue|green|off  btn: red|off|green
  emeet-led -d 5 blue           show for 5 seconds, then turn off (blocking)
  emeet-led -d 0.5 red          decimals allowed
  emeet-led -p /dev/hidraw1     explicit device path (auto-detected otherwise)

Options:
  -p PATH       explicit hidraw device path (auto-detected otherwise)
  -d SECONDS    turn off after SECONDS (blocking, decimals allowed)
  -h, --help    show this help

Needs write access to /dev/hidrawN. Install the udev rule (udev/99-emeet-m0.rules)
to allow unprivileged access, or run via sudo (script auto re-execs).
"""
import os
import sys
import time

VID = "00000483"
PID = "00005730"
HIDRAW_SYSFS = "/sys/class/hidraw"

RING_REPORTS = {3, 4, 6}
BTN_REPORTS = {3, 5}

# only presets that physically work on the device (report 3 dominates the ring)
PRESETS = {
    "red":       ("red", "off"),
    "blue":      ("blue", "off"),
    "green":     ("green", "green"),
    "btn-red":   ("off", "red"),
    "all-red":   ("red", "red"),
    "blue-red":  ("blue", "red"),
    "off":       ("off", "off"),
}

# combos not supported by the hardware
INVALID_COMBOS = (
    ("red", "green"),
    ("blue", "green"),
    ("green", "red"),
    ("off", "green"),
)


def find_hidraw() -> str:
    for name in sorted(os.listdir(HIDRAW_SYSFS)):
        uevent = os.path.join(HIDRAW_SYSFS, name, "device", "uevent")
        try:
            with open(uevent) as f:
                content = f.read()
        except OSError:
            continue
        if f"HID_ID=0003:{VID}:{PID}" in content:
            return f"/dev/{name}"
    raise SystemExit(f"eMeet M0 not found (looked for {VID}:{PID} under {HIDRAW_SYSFS})")


def write(hidraw: str, rid: int, val: int):
    with open(hidraw, "wb") as f:
        f.write(bytes([rid, 1 if val else 0]))


def apply(hidraw: str, ring: str, btn: str):
    # clear everything first, then btn reports, then ring last
    seq = [(r, 0) for r in sorted(RING_REPORTS | BTN_REPORTS)]
    if btn == "green":
        seq.append((3, 1))
    elif btn == "red":
        seq.append((5, 1))
    if ring == "green":
        seq.append((3, 1))
    elif ring == "red":
        seq.append((4, 1))
    elif ring == "blue":
        seq.append((6, 1))
    for rid, val in seq:
        write(hidraw, rid, val)


def demo(hidraw: str, per_phase: float = 2.5):
    for name in ("red", "green", "blue", "all-red", "blue-red"):
        print(f"demo: {name}", flush=True)
        apply(hidraw, *PRESETS[name])
        time.sleep(per_phase)
    apply(hidraw, "off", "off")
    print("demo done")


def main():
    args = sys.argv[1:]
    hidraw = None
    duration = None

    if "-h" in args or "--help" in args:
        print(__doc__)
        sys.exit(0)

    if "-p" in args:
        i = args.index("-p")
        hidraw = args[i + 1]
        args = args[:i] + args[i + 2:]

    if "-d" in args:
        i = args.index("-d")
        try:
            duration = float(args[i + 1])
        except (ValueError, IndexError):
            print("invalid duration for -d", file=sys.stderr)
            sys.exit(1)
        if duration <= 0:
            print("duration must be > 0", file=sys.stderr)
            sys.exit(1)
        args = args[:i] + args[i + 2:]

    if not args:
        print(__doc__)
        sys.exit(1)

    if os.geteuid() != 0 and hidraw is None:
        # without a udev rule, re-exec via sudo (passwordless sudo assumed)
        os.execvp("sudo", ["sudo", sys.executable, os.path.abspath(__file__)] + sys.argv[1:])

    hidraw = hidraw or find_hidraw()
    print(f"device: {hidraw}")

    if args[0] == "demo":
        demo(hidraw, duration or 2.5)
        return

    if len(args) == 1:
        if args[0] not in PRESETS:
            print(f"unknown preset: {args[0]}", file=sys.stderr)
            print("presets:", ", ".join(PRESETS), file=sys.stderr)
            sys.exit(1)
        ring, btn = PRESETS[args[0]]
    elif len(args) == 2:
        ring, btn = args
        if ring not in ("red", "blue", "green", "off") or btn not in ("green", "red", "off"):
            print("ring: red|blue|green|off   btn: green|red|off", file=sys.stderr)
            sys.exit(1)
    else:
        print(__doc__)
        sys.exit(1)

    for combo in INVALID_COMBOS:
        if (ring, btn) == combo:
            print(f"unsupported combo: ring={ring} btn={btn}", file=sys.stderr)
            sys.exit(1)

    apply(hidraw, ring, btn)
    if duration is not None:
        print(f"ring={ring} btn={btn} for {duration}s", flush=True)
        time.sleep(duration)
        apply(hidraw, "off", "off")
        print("off")
    else:
        print(f"ring={ring} btn={btn}")


if __name__ == "__main__":
    main()
